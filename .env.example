# ==============================================================================
# SkillSwap Campus — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# 1. Flask Security
# Generate a strong secret key (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=your_strong_random_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True

# 2. MongoDB Database Configuration (MANUAL CONFIGURATION REQUIRED)
# For MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/skillswap_campus
# If left empty in local dev, SkillSwap falls back to local mongomock for testing.
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
MONGODB_DB_NAME=skillswap_campus

# 3. Google Cloud OAuth 2.0 Credentials (MANUAL CONFIGURATION REQUIRED)
# Follow the step-by-step instructions in GOOGLE_SETUP.md to obtain these from Google Cloud Console.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Local redirect URI (match what you entered in Google Cloud Console):
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# 4. Google Gemini API Key (MANUAL CONFIGURATION REQUIRED)
# Used for SkillBot AI learning assistant and smart curriculum roadmaps.
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
